# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here: https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Editor-specific files
.idea/
.vscode/
*.swp
*.swo
Thumbs.db*

# Project specific ignores
/logo text.ai
/web/
/out/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.pdf
*.toc
*.xdv

# Patent: track figure PDFs and submission docs, ignore compiled patent PDFs
!patent/**/*.pdf
patent/patent*.pdf
patent/Spirix*.pdf

# FPGA synthesis artifacts
fpga/build/
fpga/sim/
fpga/tools/gen_font_rom/target/

# Compiled simulation binaries
fpga/rtl/blake3_tb

